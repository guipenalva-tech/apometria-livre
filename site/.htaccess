# Apometria Livre — configuração para hospedagem Apache (Hostinger)

# 1. Forçar HTTPS (a Hostinger já emite SSL grátis via Let's Encrypt no painel —
#    ative o certificado antes de descomentar/usar este bloco)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Página de erro 404 personalizada
ErrorDocument 404 /404.html

# 3. Compressão gzip (páginas carregam mais rápido)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

# 4. Cache do navegador — seguro porque CSS/JS/selo usam ?v=N (cache-busting manual)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# 5. Impede listagem de diretórios (ex.: /downloads/ sem index)
Options -Indexes
